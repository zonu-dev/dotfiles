{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(cat *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(diff *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(dotnet --list-sdks:*)",
      "Bash(dotnet tool list:*)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(iconv *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(open:*)",
      "Bash(printf:*)",
      "Bash(pwd *)",
      "Bash(python3 *)",
      "Bash(rm *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(tar -t:*)",
      "Bash(test *)",
      "Bash(unity -version:*)",
      "Bash(uloop *)",
      "Bash(unzip -l:*)",
      "Bash(unzip -t:*)",
      "Bash(wc *)",
      "Bash(wget *)",
      "Bash(which *)",
      "Bash(xargs ls *)",
      "Bash(zip -sf:*)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:json.schemastore.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.schemastore.org)",
      "WebSearch",
      "Bash(.toolchain/bin/jb:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh status:*)",
      "Bash(git --version:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git commit:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(direnv allow:*)",
      "Bash(done)",
      "Bash(gh api:*)",
      "Bash(gh auth switch:*)",
      "Bash(git checkout:*)",
      "Bash(python3:*)",
      "Bash(xargs:*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:zenn.dev)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(dd:*)",
      "Bash(diskutil:*)",
      "Bash(mount:*)",
      "Bash(lsblk:*)",
      "Bash(chown:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(mongod:*)",
      "Bash(mysql:*)",
      "Bash(psql:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh label delete:*)",
      "Bash(gh label edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo sync:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh secret set:*)",
      "Bash(gh workflow disable:*)",
      "mcp__supabase__execute_sql",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.cer)",
      "Read(**/*.crt)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*secret*)",
      "Read(**/*private*)",
      "Read(**/*-key)",
      "Read(**/*-key.*)",
      "Read(**/*-token)",
      "Read(**/*-token.*)",
      "Read(**/*_key)",
      "Read(**/*_key.*)",
      "Read(**/*_token)",
      "Read(**/*_token.*)",
      "Read(**/.key)",
      "Read(**/.token)",
      "Read(**/.token.*)",
      "Read(**/.*key)",
      "Read(**/token)",
      "Read(**/Firebase/**)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/google-services.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(~/.claude/plugins/cache/**)",
      "Edit(**/certificates/**)",
      "Edit(**/keystore/**)",
      "Edit(**/secrets/**)",
      "Edit(Library/**)",
      "Edit(ProjectSettings/**)",
      "Edit(UserSettings/**)"
    ],
    "ask": [
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh label create:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr review:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release upload:*)",
      "Bash(gh repo fork:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh workflow run:*)"
    ],
    "defaultMode": "default",
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/default-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/default-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/default-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/default-guard.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto-implement-guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/term-bg-running.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/term-bg-permission.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/term-bg-running.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/term-bg-stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/term-bg-stop.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "dig@kuu-marketplace": true,
    "agent-browser@agent-browser": true,
    "context7@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "日本語",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "voiceEnabled": true
}
