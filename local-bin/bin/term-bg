#!/usr/bin/env bash
# ghostty-bg - Change Ghostty pane background color via OSC 11
#
# Usage:
#   ghostty-bg "#1a0000"    # Set hex color
#   ghostty-bg reset        # Reset to default

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ghostty-bg <color|reset>

Examples:
  ghostty-bg "#1a0000"     # Dark red
  ghostty-bg "#000a2a"     # Dark blue
  ghostty-bg reset         # Reset to default
EOF
  exit 1
}

find_tty() {
  # 1. If stdout is a tty, use it directly
  if [ -t 1 ]; then
    echo "/dev/stdout"
    return
  fi

  # 2. Walk up the process tree to find a tty
  local pid=$$
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    local tty
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    if [ -n "$tty" ] && [ "$tty" != "??" ]; then
      local dev="/dev/$tty"
      if [ -w "$dev" ]; then
        echo "$dev"
        return
      fi
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done

  echo "Error: No writable tty found" >&2
  return 1
}

[ $# -eq 1 ] || usage

tty_dev=$(find_tty)

if [ "$1" = "reset" ]; then
  printf '\e]111;\a' > "$tty_dev"
else
  printf '\e]11;%s\a' "$1" > "$tty_dev"
fi
